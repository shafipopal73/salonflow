{
  "name": "ServiceNote",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "note",
        "extension",
        "extra_service"
      ],
      "default": "note"
    },
    "content": {
      "type": "string"
    },
    "salon_id": {
      "type": "string"
    }
  },
  "required": [
    "service_id",
    "author_name",
    "content"
  ],
  "rls": {
    "create": {
      "data.salon_id": "{{user.data.salon_id}}"
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.salon_id": "{{user.data.salon_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "data.author_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.salon_id": "{{user.data.salon_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "data.author_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.salon_id": "{{user.data.salon_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "data.author_id": "{{user.id}}"
        }
      ]
    }
  }
}